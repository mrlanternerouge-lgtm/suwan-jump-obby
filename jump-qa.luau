task.spawn(function() local ok,err=pcall(function() local p=game.Players:GetPlayers()[1]; local m=workspace.Obby; local prev=m.Start; for i=1,16 do local target=i==16 and m.Goal or m["Stage"..i]; local c=p.Character; local h=c.Humanoid; local r=c.HumanoidRootPart; r:SetNetworkOwner(nil); local launch=prev.Position+Vector3.new(0,4,-prev.Size.Z/2+1); c:PivotTo(CFrame.new(launch)); r.AssemblyLinearVelocity=Vector3.zero; task.wait(0.4); local dest=target.Position+Vector3.new(0,3,target.Size.Z/2-1.4); h:MoveTo(dest); h.Jump=true; task.wait(1.1); assert(c==p.Character and h.Health>0,"died on jump "..i); local d=r.Position-target.Position; assert(math.abs(d.X)<target.Size.X/2+1 and math.abs(d.Z)<target.Size.Z/2+1 and d.Y>0,"missed jump "..i.." "..tostring(d)); print("OBBY_JUMP PASS "..i); if i==6 or i==10 or i==14 then h:MoveTo(target.Position+Vector3.new(0,3,-target.Size.Z/2+1.4)); h.Jump=true; task.wait(0.9); assert(h.Health>0,"hurdle "..i); print("OBBY_HURDLE PASS "..i) end; prev=target end; print("OBBY_JUMP ALL PASS") end); if not ok then warn("OBBY_JUMP FAIL "..tostring(err)) end end)