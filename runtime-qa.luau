task.spawn(function() local ok,err=pcall(function() assert(game:GetService("RunService"):IsServer(),"server required"); local p=game.Players:GetPlayers()[1]; assert(p,"no player"); local m=workspace.Obby; local function land(part) local c=p.Character; c:PivotTo(CFrame.new(part.Position+Vector3.new(0,4,0))); c.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero; task.wait(1) end; local function dieAndCheck(target) local old=p.Character; land(m.Lava); task.wait(3); assert(p.Character~=old,"did not respawn"); local d=p.Character.HumanoidRootPart.Position-target.Position; print("OBBY_QA position "..target.Name.." "..tostring(d)); assert(math.abs(d.X)<target.Size.X/2+1 and math.abs(d.Z)<target.Size.Z/2+1 and d.Y>0 and d.Y<8,"wrong respawn"); print("OBBY_QA respawn PASS "..target.Name) end; assert(p:GetAttribute("Checkpoint")==0,"initial checkpoint"); dieAndCheck(m.Start); land(m.Goal); assert(not p:GetAttribute("Won"),"early goal"); for _,i in {4,8,12} do land(m["Stage"..i]); assert(p:GetAttribute("Checkpoint")==i,"checkpoint "..i); dieAndCheck(m["Stage"..i]) end; land(m.Stage4); assert(p:GetAttribute("Checkpoint")==12,"checkpoint regressed"); land(m.Hazard14); task.wait(3); assert(p.Character.Humanoid.Health>0,"hazard respawn"); assert((p.Character.HumanoidRootPart.Position-m.Stage12.Position).Magnitude<10,"hazard checkpoint"); land(m.Goal); assert(p:GetAttribute("Won"),"goal failed"); print("OBBY_QA ALL PASS") end); if not ok then warn("OBBY_QA FAIL "..tostring(err)) end end)